root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# Test resources can contain intentional whitespace and invalid source.
[{*.yml,*.yaml,*.md}]
trim_trailing_whitespace = true

[**/src/test/resources/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
