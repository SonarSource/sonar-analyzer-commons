{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks.py\" post-tool-use",
            "timeout": 3600,
            "statusMessage": "Reporting local checks after git push"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks.py\" stop",
            "timeout": 60,
            "statusMessage": "Checking local and PR status"
          }
        ]
      }
    ]
  }
}
