{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks.py\" pre-tool-use"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks.py\" stop"}
        ]
      }
    ]
  }
}
